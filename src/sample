//catching headers 
    let catch_access_token: Option<&str> = head_req.headers().get("Authorization").and_then(|v| v.to_str().ok()); 
    
    //Consider if there is not a token & User...
    if let Some(token) = catch_access_token {
        print!("Token is :::: {}", token);
        //extracting user from access_token
        
        let newuser: Option<User> = match auth_service.verify_token(token) {
            Ok(decode_string) => {
                let usermail: String = decode_string.claims.email;
                //Grab user from usermail...
                match db1.get_user_by_email(&usermail).await {
                    Ok(user) => user,
                    Err(_) => {
                        return HttpResponse::InternalServerError().json(ApiResponse::<()>::error(
                            "failed to find User".to_string()
                        ));
                    }
                }
            }
            Err(_) => {
                return HttpResponse::Unauthorized().json(ApiResponse::<()>::error(
                    "failed to extract User Email".to_string()
            ));
        }
        };

        //Unwrap user which is in Option Type 
        let Some(user) = newuser else {
            println!("[ DeviceHandler ] :::>>>  User can not find....");
            return HttpResponse::NotFound().json(
                ApiResponse::<()>::error("user not found".to_string())
            );
        };


    //catch Ip Address as we need....
    let ip: Option<IpNetwork> = req.ip_addr.as_ref().and_then(|s| s.parse().ok());
    //creating device....
    let saved_device: Device = match db.create_device(
        user.id, &user.username, &req.category, &req.model, &req.username, 
        &req.hostname, req.port_no, ip.as_ref()
    )
    .await {
        Ok(device) => device,
        Err(e) => {
            eprintln!("[ DeviceHandler ] :::>>> device creation is failed: {e:?}");
            return HttpResponse::InternalServerError().json(ApiResponse::<()>::error(
                "Failed to create Device & try again".to_string()
            ));
        }
    };


        //Sending Http Response back....
    HttpResponse::Created().json(ApiResponse::success(DeviceResponse {
            userid:user.id,
            userusername: user.username,
            category: saved_device.category,
            model: saved_device.model,
            username: saved_device.username,
            hostname: saved_device.hostname,
            port_no: saved_device.port_no,
            ip_addr: saved_device.ip_addr,
            is_active: saved_device.is_active,
            created_at: saved_device.created_at,
            updated_at: saved_device.updated_at,
        }))
    
    }else {
        println!("[ DeviceHandler ] :::>>>  No Token can be caught....");
        return HttpResponse::Unauthorized().finish();
    }